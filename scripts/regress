#!/usr/bin/env bash
#
# scripts/regress -- single-backend conformance-test runner.
#
# Wraps `cargo test` with the right feature flags and test-name filters
# for one backend at a time, complementing scripts/platform-conformance.sh
# (which is a multi-lane release gate, not a developer iteration tool).
#
# Usage:
#   scripts/regress --backend tui                          # run all TUI scenarios
#   scripts/regress --backend gtk --area tab-bar           # run only tab-bar scenarios on GTK
#   scripts/regress --backend macos --list                 # list macOS-capable scenarios
#   scripts/regress --backend tui --list --json            # list as JSON
#   scripts/regress --backend gtk --guided                 # (placeholder) visual checklist
#   scripts/regress --backend win --json                   # run win scenarios, JSON output
#
# Exit codes (same discipline as platform-conformance.sh):
#   0  all selected scenarios passed
#   1  at least one scenario failed (or zero tests ran -- the #645 guard)
#   2  the selected backend is not available on this host
#   3  internal error (bad arguments, missing cargo, etc.)
#
set -euo pipefail

# -- Constants ---------------------------------------------------------------

EXIT_PASS=0
EXIT_FAIL=1
EXIT_SKIP=2
EXIT_ERROR=3

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# -- Argument parsing --------------------------------------------------------

BACKEND=""
AREA=""
LIST=false
GUIDED=false
JSON=false

usage() {
    cat <<'EOF'
Usage: scripts/regress --backend <tui|gtk|macos|win> [OPTIONS]

Options:
  --backend <name>   Required. One of: tui, gtk, macos, win.
  --area <area>      Filter to a feature area (e.g. tab-bar, scroll, editor).
  --list             List available scenarios for this backend without running.
  --guided           (Placeholder) Visual checklist mode.
  --json             Output results as JSON.
  -h, --help         Show this help.

Exit codes:
  0  all pass    1  failures    2  backend not available    3  error
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --backend)
            BACKEND="$2"
            shift 2
            ;;
        --area)
            AREA="$2"
            shift 2
            ;;
        --list)
            LIST=true
            shift
            ;;
        --guided)
            GUIDED=true
            shift
            ;;
        --json)
            JSON=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "error: unknown argument: $1" >&2
            usage >&2
            exit $EXIT_ERROR
            ;;
    esac
done

if [[ -z "$BACKEND" ]]; then
    echo "error: --backend is required" >&2
    usage >&2
    exit $EXIT_ERROR
fi

case "$BACKEND" in
    tui|gtk|macos|win) ;;
    *)
        echo "error: unknown backend: $BACKEND (must be tui, gtk, macos, or win)" >&2
        exit $EXIT_ERROR
        ;;
esac

# -- Guided mode (placeholder) ----------------------------------------------

if $GUIDED; then
    echo "Phase 0.5 visual checklist: not yet implemented."
    echo "Run without --guided to execute tests, or --list to see available scenarios."
    exit 0
fi

# -- Backend availability probe ---------------------------------------------
# Mirrors platform-conformance.sh's probe logic.

probe_backend() {
    case "$1" in
        tui)
            return 0
            ;;
        gtk)
            if command -v pkg-config >/dev/null 2>&1 && pkg-config --modversion gtk4 >/dev/null 2>&1; then
                return 0
            else
                echo "gtk backend: gtk4 not found via pkg-config" >&2
                return 1
            fi
            ;;
        macos)
            if [[ "$(uname)" == "Darwin" ]]; then
                return 0
            else
                echo "macos backend: requires macOS (uname = Darwin)" >&2
                return 1
            fi
            ;;
        win)
            if command -v cargo-xwin >/dev/null 2>&1; then
                return 0
            else
                echo "win backend: cargo-xwin not found on PATH" >&2
                return 1
            fi
            ;;
    esac
}

# -- Scenario label collection ------------------------------------------------
# Collect all backend_conformance! labels from source. This is the single
# source of truth for "which scenarios exist" -- both --list and the
# per-scenario run-mode table below read from it, so the scenario set can
# never drift between the two.
#
# Matches indented `label: <ident>,` lines that are not inside comments
# or strings (the macro definition's `$label:ident` is filtered by the
# leading `$`).
all_labels() {
    cd "$REPO_DIR"
    grep -E '^[[:space:]]+label: ' src/harness.rs 2>/dev/null \
        | grep -v '//' | grep -v '"' | grep -v '\$' \
        | sed 's/.*label: *//' | sed 's/,.*//' || true
}

# -- List mode ---------------------------------------------------------------

if $LIST; then
    cd "$REPO_DIR"

    LABELS=$(all_labels)

    if [[ -z "$LABELS" ]]; then
        echo "No backend_conformance! scenarios found in src/harness.rs" >&2
        exit $EXIT_ERROR
    fi

    # Filter to scenarios that include this backend.
    # All current macro invocations use backends: [gtk, tui, tui_prod].
    filter_for_backend() {
        local backend="$1"
        case "$backend" in
            tui|tui_prod|gtk)
                echo "$LABELS"
                ;;
            macos|win)
                echo ""
                ;;
        esac
    }

    FILTERED=$(filter_for_backend "$BACKEND")

    if [[ -z "$FILTERED" ]]; then
        if $JSON; then
            echo "[]"
        else
            echo "No scenarios available for backend '$BACKEND'."
        fi
        exit 0
    fi

    if [[ -n "$AREA" ]]; then
        echo "# Note: --area filtering requires the compiled scenario registry." >&2
        echo "# Showing all scenarios for backend '$BACKEND'; filter visually." >&2
    fi

    if $JSON; then
        echo "["
        first=true
        while IFS= read -r label; do
            [[ -z "$label" ]] && continue
            if $first; then
                first=false
            else
                echo ","
            fi
            printf '  {"name": "%s", "backend": "%s"}' "$label" "$BACKEND"
        done <<< "$FILTERED"
        echo ""
        echo "]"
    else
        printf "%-60s %s\n" "SCENARIO" "BACKEND"
        printf "%-60s %s\n" "--------" "-------"
        while IFS= read -r label; do
            [[ -z "$label" ]] && continue
            printf "%-60s %s\n" "$label" "$BACKEND"
        done <<< "$FILTERED"
    fi
    exit 0
fi

# -- Probe before running ---------------------------------------------------

if ! probe_backend "$BACKEND"; then
    echo "Backend '$BACKEND' is not available on this host." >&2
    exit $EXIT_SKIP
fi

# -- Build the cargo test command -------------------------------------------

cd "$REPO_DIR"

cargo_cmd=()
cargo_test_filter=""

case "$BACKEND" in
    tui)
        cargo_cmd=(cargo test --no-default-features)
        cargo_test_filter="harness::"
        ;;
    gtk)
        cargo_cmd=(cargo test)
        cargo_test_filter="harness::"
        ;;
    macos)
        cargo_cmd=(cargo test --lib --no-default-features --features macos)
        cargo_test_filter="macos::"
        ;;
    win)
        if [[ "$(uname -s)" == *MINGW* ]] || [[ "$(uname -s)" == *MSYS* ]] || [[ "$(uname -s)" == *CYGWIN* ]]; then
            cargo_cmd=(cargo test --no-default-features --features win)
        else
            export RUSTFLAGS="${RUSTFLAGS:-} -C target-feature=+crt-static"
            cargo_cmd=(cargo xwin test --target x86_64-pc-windows-msvc --no-default-features --features win)
        fi
        cargo_test_filter="win::"
        ;;
esac

# -- Area filter -> cargo test name filter ----------------------------------

if [[ -n "$AREA" ]]; then
    case "$AREA" in
        tab-bar)         cargo_test_filter="harness::.*tab_bar" ;;
        scroll)          cargo_test_filter="harness::.*scroll" ;;
        source-control)  cargo_test_filter="harness::.*sc_" ;;
        activity-bar)    cargo_test_filter="harness::.*activity_bar" ;;
        context-menu)    cargo_test_filter="harness::.*context_menu" ;;
        command-palette) cargo_test_filter="harness::.*command_palette" ;;
        drag-drop)       cargo_test_filter="harness::.*drag" ;;
        settings)        cargo_test_filter="harness::.*settings" ;;
        keyboard)        cargo_test_filter="harness::.*ctrl_w" ;;
        explorer|file-ops) cargo_test_filter="harness::.*explorer" ;;
        editor)          cargo_test_filter="harness::.*hover" ;;
        chrome)          cargo_test_filter="harness::.*confirm\|harness::.*sweep\|harness::.*bottom" ;;
        debug-output)    cargo_test_filter="harness::.*debug_output" ;;
        *)
            echo "warning: unknown area '$AREA', running all scenarios" >&2
            ;;
    esac
fi

# -- Run --------------------------------------------------------------------

echo "=== regress: backend=$BACKEND area=${AREA:-all} ==="
echo "Command: ${cargo_cmd[*]} -- $cargo_test_filter"
echo ""

# The full cargo output is kept on disk (never deleted) and its path is
# always printed, so the operator can inspect the complete log after the
# short table below.
OUTFILE="$(mktemp -t "vimcode-regress.${BACKEND}.XXXXXX.log")"

set +e
"${cargo_cmd[@]}" -- "$cargo_test_filter" 2>&1 | tee "$OUTFILE"
TEST_EXIT=${PIPESTATUS[0]}
set -e

# -- Parse results ----------------------------------------------------------
#
# `cargo test` runs one "test result:" line *per test binary* (the lib
# unittests, each integration-test file, each bin target), not one for the
# whole invocation. Only the binary that actually contains harness::/macos::/
# win:: tests reports a nonzero count; the rest report "0 passed; 0 failed"
# for that binary. Summing across every "test result:" line (rather than
# reading just the last one) gives the true total regardless of how many
# binaries cargo happened to run.

PASSED=$(grep -E '^test result: ' "$OUTFILE" | grep -oE '[0-9]+ passed' | grep -oE '[0-9]+' | awk '{s+=$1} END{print s+0}')
FAILED=$(grep -E '^test result: ' "$OUTFILE" | grep -oE '[0-9]+ failed' | grep -oE '[0-9]+' | awk '{s+=$1} END{print s+0}')

# The #645 vacuous-green guard: if zero tests ran, that is a failure.
TOTAL=$((PASSED + FAILED))
if [[ $TOTAL -eq 0 && $TEST_EXIT -eq 0 ]]; then
    echo ""
    echo "ERROR: zero tests ran -- this is the #645 vacuous-green trap, not a pass."
    echo "The backend '$BACKEND' with filter '$cargo_test_filter' matched no test functions."
    TEST_EXIT=1
fi

# -- Per-scenario table -------------------------------------------------
# Build one row per scenario per backend variant actually reported by
# cargo's own test harness, so this table can never disagree with
# `cargo test`'s own verdict for the scenario it describes. For tui/gtk,
# scenario names are cross-referenced against the full label set from
# src/harness.rs so a scenario that didn't run at all (e.g. filtered out
# by --area) is still shown, as a skip, rather than silently omitted.

declare -a TABLE_ROWS=()

parse_backend_suffix() {
    case "$1" in
        *::tui_prod) echo "tui_prod" ;;
        *::tui)      echo "tui" ;;
        *::gtk)      echo "gtk" ;;
        *)           echo "" ;;
    esac
}

# Lines look like: "test harness::tests::some_label::tui ... ok". Some
# driver tests write a raw terminal title-set escape sequence straight to
# the fd with no trailing newline, which can land immediately before the
# next test's result line and shift it off column 0 -- so the match below
# is not anchored to the start of the line, only to "test <path> ... ".
while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    test_path=$(echo "$line" | sed -E 's/.*test ([^ ]+) \.\.\..*/\1/')
    outcome=$(echo "$line" | sed -E 's/.*test [^ ]+ \.\.\. (ok|FAILED|ignored).*/\1/')
    suffix=$(parse_backend_suffix "$test_path")
    if [[ -n "$suffix" ]]; then
        # harness::...::<label>::<suffix> -> <label> is the segment before the suffix.
        label=$(echo "$test_path" | sed -E "s/::${suffix}\$//" | sed -E 's/.*:://')
    else
        label="$test_path"
        suffix="$BACKEND"
    fi
    case "$outcome" in
        ok)      result="pass" ;;
        FAILED)  result="fail" ;;
        ignored) result="skip (cargo test marked #[ignore])" ;;
        *)       result="unknown" ;;
    esac
    TABLE_ROWS+=("${label}\t${suffix}\t${result}")
done < <(grep -E 'test [^ ]+ \.\.\. (ok|FAILED|ignored)' "$OUTFILE" || true)

# For tui/gtk, add a skip row for every registered scenario that produced
# no row at all (most commonly: filtered out by --area).
#
# The lookup below is a plain associative array built with a non-piped
# `for` loop, not a `printf ... | grep -q` pipeline. Under `set -o
# pipefail` (part of `set -euo pipefail` above), a `grep -q` that matches
# and exits early can SIGPIPE the still-writing `printf`, and pipefail then
# reports that SIGPIPE as the pipeline's exit status even though the grep
# match itself succeeded -- turning a real match into a spurious "not
# matched" skip row for a scenario that actually ran and passed. That
# failure mode is data-dependent (it only shows up when a match lands
# early enough in a large TABLE_ROWS to let the writer get SIGPIPE'd), so
# it does not reproduce on every run with every label.
if [[ "$BACKEND" == "tui" || "$BACKEND" == "gtk" ]]; then
    declare -A SEEN_LABELS=()
    for row in "${TABLE_ROWS[@]:-}"; do
        [[ -z "$row" ]] && continue
        row_label="${row%%\\t*}"
        SEEN_LABELS["$row_label"]=1
    done

    ALL_LABELS=$(all_labels)
    while IFS= read -r label; do
        [[ -z "$label" ]] && continue
        if [[ -z "${SEEN_LABELS[$label]:-}" ]]; then
            reason="not matched by filter '$cargo_test_filter'"
            TABLE_ROWS+=("${label}\t${BACKEND}\tskip (${reason})")
        fi
    done <<< "$ALL_LABELS"
fi

# -- Output -----------------------------------------------------------------

VERDICT="$([ $TEST_EXIT -eq 0 ] && echo "pass" || echo "fail")"

echo ""
echo "=== regress: per-scenario results ==="
printf "%-70s %-10s %s\n" "SCENARIO" "BACKEND" "RESULT"
printf "%-70s %-10s %s\n" "--------" "-------" "------"
for row in "${TABLE_ROWS[@]:-}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r r_label r_backend r_result <<< "$(echo -e "$row")"
    printf "%-70s %-10s %s\n" "$r_label" "$r_backend" "$r_result"
done

echo ""
echo "Full log: $OUTFILE"
echo ""
echo "=== regress summary ==="

if $JSON; then
    cat <<ENDJSON
{
  "backend": "$BACKEND",
  "area": "${AREA:-all}",
  "passed": $PASSED,
  "failed": $FAILED,
  "total": $TOTAL,
  "verdict": "$VERDICT",
  "exit": $TEST_EXIT,
  "log": "$OUTFILE"
}
ENDJSON
else
    echo "Backend:  $BACKEND"
    echo "Area:     ${AREA:-all}"
    echo "Passed:   $PASSED"
    echo "Failed:   $FAILED"
    echo "Total:    $TOTAL"
    echo "Log:      $OUTFILE"
    if [[ $TEST_EXIT -eq 0 ]]; then
        echo "Verdict:  PASS"
    else
        echo "Verdict:  FAIL"
    fi
fi

echo "REGRESS_SUMMARY backend=$BACKEND area=${AREA:-all} passed=$PASSED failed=$FAILED total=$TOTAL verdict=$VERDICT exit=$TEST_EXIT log=$OUTFILE"

exit $TEST_EXIT
