#!/usr/bin/env bash
#
# scripts/regress -- single-backend conformance-test runner.
#
# Wraps `cargo test` with the right feature flags and test-name filters
# for one backend at a time, complementing scripts/platform-conformance.sh
# (which is a multi-lane release gate, not a developer iteration tool).
#
# Usage:
#   scripts/regress --backend tui                          # run all TUI scenarios
#   scripts/regress --backend gtk --area tab-bar           # run only tab-bar scenarios on GTK
#   scripts/regress --backend macos --list                 # list macOS-capable scenarios
#   scripts/regress --backend tui --list --json            # list as JSON
#   scripts/regress --backend tui --guided                 # guided visual checklist
#   scripts/regress --backend win --json                   # run win scenarios, JSON output
#
# --guided walks the backend-neutral checklist in tests/regress/checklist.toml,
# driving the real app through existing ex-commands/keybindings into the state
# each item needs, then asks for a y (pass) / n (fail) / s (skip) judgement.
# On tui it launches the real `vcd` binary in a tmux session and drives it with
# `tmux send-keys`; on gtk/macos/win there is no backend-neutral way to inject
# real GUI input (adding one would mean new per-backend code, see
# CLAUDE.md's Platform-Neutrality Rule), so those backends print each setup
# step as an instruction for the operator to perform by hand. A
# `regress-<backend>-<sha>-<date>.md` results file, ready to paste into a
# release PR, is written at the end either way.
#
# Exit codes (same discipline as platform-conformance.sh):
#   0  all selected scenarios passed (guided: no failed items)
#   1  at least one scenario failed (or zero tests ran -- the #645 guard)
#   2  the selected backend is not available on this host
#   3  internal error (bad arguments, missing cargo, missing checklist, etc.)
#
# Testing hooks (used by tests/regress_script.rs; not part of the documented
# interface, no compatibility promise beyond that suite):
#   REGRESS_CMD_<BACKEND>="<shell command>"  replaces the `cargo test`
#       invocation for that backend. The command's stdout+stderr is parsed
#       exactly as cargo's would be, and its exit status is the run's.
#   REGRESS_OVERRIDE_<BACKEND>=1|0           replaces that backend's real
#       availability probe (1 = available, 0 = not available).
#   REGRESS_HARNESS_FILE=<path>              replaces src/harness.rs as the
#       source of the `backend_conformance!` label set.
#   REGRESS_CHECKLIST_FILE=<path>            replaces tests/regress/checklist.toml
#       as the --guided item source.
#   REGRESS_GUIDED_CMD_<BACKEND>="<shell command>"  replaces the launch/send/kill
#       driver for --guided on that backend. Invoked once per verb as
#       `regress-guided-stub <verb> <arg>` (verb is launch/send/kill; arg is
#       the setup step for send, empty otherwise).
#   REGRESS_GUIDED_OUT_DIR=<dir>              replaces the repo root as the
#       directory the --guided results file is written into.
# <BACKEND> is the upper-cased backend name (TUI, GTK, MACOS, WIN).
#
set -euo pipefail

# -- Constants ---------------------------------------------------------------

EXIT_PASS=0
EXIT_FAIL=1
EXIT_SKIP=2
EXIT_ERROR=3

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# -- Argument parsing --------------------------------------------------------

BACKEND=""
AREA=""
LIST=false
GUIDED=false
JSON=false

usage() {
    cat <<'EOF'
Usage: scripts/regress --backend <tui|gtk|macos|win> [OPTIONS]

Options:
  --backend <name>   Required. One of: tui, gtk, macos, win.
  --area <area>      Filter to a feature area (e.g. tab-bar, scroll, editor).
  --list             List available scenarios for this backend without running.
  --guided           Walk the visual checklist (tests/regress/checklist.toml)
                     against the real app instead of running cargo tests.
  --json             Output results as JSON.
  -h, --help         Show this help.

Exit codes:
  0  all pass    1  failures    2  backend not available    3  error
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --backend)
            BACKEND="$2"
            shift 2
            ;;
        --area)
            AREA="$2"
            shift 2
            ;;
        --list)
            LIST=true
            shift
            ;;
        --guided)
            GUIDED=true
            shift
            ;;
        --json)
            JSON=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "error: unknown argument: $1" >&2
            usage >&2
            exit $EXIT_ERROR
            ;;
    esac
done

if [[ -z "$BACKEND" ]]; then
    echo "error: --backend is required" >&2
    usage >&2
    exit $EXIT_ERROR
fi

case "$BACKEND" in
    tui|gtk|macos|win) ;;
    *)
        echo "error: unknown backend: $BACKEND (must be tui, gtk, macos, or win)" >&2
        exit $EXIT_ERROR
        ;;
esac

# -- Backend availability probe ---------------------------------------------
# Mirrors platform-conformance.sh's probe logic.

backend_upper() {
    printf '%s' "$1" | tr '[:lower:]' '[:upper:]'
}

probe_backend() {
    local override_var
    override_var="REGRESS_OVERRIDE_$(backend_upper "$1")"
    local override="${!override_var:-}"
    if [[ -n "$override" ]]; then
        if [[ "$override" == "1" ]]; then
            return 0
        fi
        echo "$1 backend: unavailable (probe overridden)" >&2
        return 1
    fi

    case "$1" in
        tui)
            return 0
            ;;
        gtk)
            if command -v pkg-config >/dev/null 2>&1 && pkg-config --modversion gtk4 >/dev/null 2>&1; then
                return 0
            else
                echo "gtk backend: gtk4 not found via pkg-config" >&2
                return 1
            fi
            ;;
        macos)
            if [[ "$(uname)" == "Darwin" ]]; then
                return 0
            else
                echo "macos backend: requires macOS (uname = Darwin)" >&2
                return 1
            fi
            ;;
        win)
            if command -v cargo-xwin >/dev/null 2>&1; then
                return 0
            else
                echo "win backend: cargo-xwin not found on PATH" >&2
                return 1
            fi
            ;;
    esac
}

# -- Scenario label collection ------------------------------------------------
# Collect all backend_conformance! labels from source. This is the single
# source of truth for "which scenarios exist" -- both --list and the
# per-scenario run-mode table below read from it, so the scenario set can
# never drift between the two.
#
# Matches indented `label: <ident>,` lines that are not inside comments
# or strings (the macro definition's `$label:ident` is filtered by the
# leading `$`).
all_labels() {
    cd "$REPO_DIR"
    local harness_file="${REGRESS_HARNESS_FILE:-src/harness.rs}"
    grep -E '^[[:space:]]+label: ' "$harness_file" 2>/dev/null \
        | grep -v '//' | grep -v '"' | grep -v '\$' \
        | sed 's/.*label: *//' | sed 's/,.*//' || true
}

# -- List mode ---------------------------------------------------------------

if $LIST; then
    cd "$REPO_DIR"

    LABELS=$(all_labels)

    if [[ -z "$LABELS" ]]; then
        echo "No backend_conformance! scenarios found in ${REGRESS_HARNESS_FILE:-src/harness.rs}" >&2
        exit $EXIT_ERROR
    fi

    # Filter to scenarios that include this backend.
    # All current macro invocations use backends: [gtk, tui, tui_prod].
    filter_for_backend() {
        local backend="$1"
        case "$backend" in
            tui|tui_prod|gtk)
                echo "$LABELS"
                ;;
            macos|win)
                echo ""
                ;;
        esac
    }

    FILTERED=$(filter_for_backend "$BACKEND")

    if [[ -z "$FILTERED" ]]; then
        if $JSON; then
            echo "[]"
        else
            echo "No scenarios available for backend '$BACKEND'."
        fi
        exit 0
    fi

    if [[ -n "$AREA" ]]; then
        echo "# Note: --area filtering requires the compiled scenario registry." >&2
        echo "# Showing all scenarios for backend '$BACKEND'; filter visually." >&2
    fi

    if $JSON; then
        echo "["
        first=true
        while IFS= read -r label; do
            [[ -z "$label" ]] && continue
            if $first; then
                first=false
            else
                echo ","
            fi
            printf '  {"name": "%s", "backend": "%s"}' "$label" "$BACKEND"
        done <<< "$FILTERED"
        echo ""
        echo "]"
    else
        printf "%-60s %s\n" "SCENARIO" "BACKEND"
        printf "%-60s %s\n" "--------" "-------"
        while IFS= read -r label; do
            [[ -z "$label" ]] && continue
            printf "%-60s %s\n" "$label" "$BACKEND"
        done <<< "$FILTERED"
    fi
    exit 0
fi

# -- Probe before running ---------------------------------------------------

if ! probe_backend "$BACKEND"; then
    echo "Backend '$BACKEND' is not available on this host." >&2
    exit $EXIT_SKIP
fi

# -- Guided mode --------------------------------------------------------------
#
# Walks the backend-neutral checklist (tests/regress/checklist.toml by
# default), driving the real app through the same ex-commands/keybindings a
# user would use, then asks a human -- or a piped answer stream, for test
# determinism -- to judge each item as pass/fail/skip. See the module header
# for the REGRESS_CHECKLIST_FILE / REGRESS_GUIDED_CMD_<BACKEND> /
# REGRESS_GUIDED_OUT_DIR testing hooks.

if $GUIDED; then
    CHECKLIST_FILE="${REGRESS_CHECKLIST_FILE:-$REPO_DIR/tests/regress/checklist.toml}"

    if [[ ! -f "$CHECKLIST_FILE" ]]; then
        echo "error: checklist file not found: $CHECKLIST_FILE" >&2
        exit $EXIT_ERROR
    fi
    if ! command -v awk >/dev/null 2>&1; then
        echo "error: --guided requires awk to read the checklist" >&2
        exit $EXIT_ERROR
    fi

    # Emits one record line per [[item]]: id, prompt, reference, backends
    # (comma-joined; empty = all backends), setup (comma-joined steps) --
    # fields separated by ASCII unit separator (\x1f), deliberately not a
    # tab. Bash's `read` treats tab (like space and newline) as "IFS
    # whitespace" no matter what IFS is set to: runs of it collapse into one
    # delimiter and leading/trailing runs are stripped, which silently drops
    # empty fields (e.g. a missing `reference`) instead of preserving them.
    # \x1f is not IFS whitespace, so empty fields round-trip correctly.
    #
    # The checklist is a deliberately small TOML subset -- [[item]] tables
    # holding only single-line string and array-of-string fields -- so it is
    # parsed here in POSIX awk. awk is the only text-processing dependency the
    # rest of the script already has; a TOML library (or any python) would add
    # an interpreter this script cannot assume on every host it runs on.
    CHECKLIST_AWK=$(cat <<'AWKEOF'
BEGIN { SEP = sprintf("%c", 31); in_item = 0 }

# Collected quoted strings of the value last parsed: SV[1..SN].
function clear_strings(    i) {
    for (i = 1; i <= SN; i++) delete SV[i]
    SN = 0
}

# Splits a value into its quoted strings, honouring \" and \\ escapes and
# stopping at an unquoted `#` comment.
function parse_strings(raw,    i, c, n, inq, esc, cur) {
    clear_strings()
    n = length(raw)
    inq = 0; esc = 0; cur = ""
    for (i = 1; i <= n; i++) {
        c = substr(raw, i, 1)
        if (inq) {
            if (esc) { cur = cur c; esc = 0 }
            else if (c == "\\") { esc = 1 }
            else if (c == "\"") { inq = 0; SN = SN + 1; SV[SN] = cur; cur = "" }
            else { cur = cur c }
        } else if (c == "\"") { inq = 1; cur = "" }
        else if (c == "#") { break }
    }
}

function join_strings(    i, out) {
    out = ""
    for (i = 1; i <= SN; i++) out = (i == 1 ? SV[i] : out "," SV[i])
    return out
}

# A field separator inside a value would desync the record, so it never
# survives into one.
function clean(s) {
    gsub(SEP, " ", s)
    return s
}

function flush_item() {
    if (in_item && f_id != "") {
        print clean(f_id) SEP clean(f_prompt) SEP clean(f_ref) SEP \
              clean(f_backends) SEP clean(f_setup)
    }
    f_id = ""; f_prompt = ""; f_ref = ""; f_backends = ""; f_setup = ""
}

{
    line = $0
    sub(/^[ \t]+/, "", line)
    sub(/[ \t]+$/, "", line)
    if (line == "" || substr(line, 1, 1) == "#") next
    if (index(line, "[[item]]") == 1) { flush_item(); in_item = 1; next }
    if (substr(line, 1, 1) == "[") { flush_item(); in_item = 0; next }
    if (!in_item) next
    if (line !~ /^[A-Za-z_]+[ \t]*=/) next

    eq = index(line, "=")
    key = substr(line, 1, eq - 1)
    sub(/[ \t]+$/, "", key)
    raw = substr(line, eq + 1)
    sub(/^[ \t]+/, "", raw)
    parse_strings(raw)
    if (substr(raw, 1, 1) == "[") val = join_strings()
    else val = (SN > 0 ? SV[1] : "")

    if (key == "id") f_id = val
    else if (key == "prompt") f_prompt = val
    else if (key == "reference") f_ref = val
    else if (key == "backends") f_backends = val
    else if (key == "setup") f_setup = val
}

END { flush_item() }
AWKEOF
)

    checklist_items_tsv() {
        awk "$CHECKLIST_AWK" "$CHECKLIST_FILE"
    }

    # True (0) when an item with the given comma-joined `backends` list
    # applies to `backend` -- an empty list means "every backend".
    item_applies_to_backend() {
        local backends_csv="$1" backend="$2"
        [[ -z "$backends_csv" ]] && return 0
        local -a backends
        IFS=',' read -ra backends <<< "$backends_csv"
        local b
        for b in "${backends[@]}"; do
            [[ "$b" == "$backend" ]] && return 0
        done
        return 1
    }

    GUIDED_TMUX_SESSION="vimcode-regress-guided-$$"
    VCD_BIN="$REPO_DIR/target/debug/vcd"

    # Sends one checklist "setup" step to the running tmux session, through
    # the same ex-command/keybinding surface a user would type -- never a
    # test-only injection path.
    tui_send_step() {
        local step="$1"
        case "$step" in
            open:*)
                tmux send-keys -t "$GUIDED_TMUX_SESSION" Escape
                tmux send-keys -t "$GUIDED_TMUX_SESSION" ":e $REPO_DIR/tests/regress/fixtures/${step#open:}" Enter
                ;;
            ex:*)
                tmux send-keys -t "$GUIDED_TMUX_SESSION" Escape
                tmux send-keys -t "$GUIDED_TMUX_SESSION" ":${step#ex:}" Enter
                ;;
            keys:*)
                tmux send-keys -t "$GUIDED_TMUX_SESSION" "${step#keys:}"
                ;;
            *)
                echo "warning: unknown setup step '$step', ignoring" >&2
                ;;
        esac
        sleep 0.2
    }

    tui_guided_driver() {
        local verb="$1" arg="${2:-}"
        case "$verb" in
            launch)
                if [[ ! -x "$VCD_BIN" ]]; then
                    echo "Building vcd (debug, no-default-features)..." >&2
                    (cd "$REPO_DIR" && cargo build --no-default-features --bin vcd) >&2
                fi
                tmux new-session -d -s "$GUIDED_TMUX_SESSION" -x 120 -y 40 "$VCD_BIN"
                sleep 0.3
                ;;
            send)
                tui_send_step "$arg"
                ;;
            kill)
                tmux kill-session -t "$GUIDED_TMUX_SESSION" >/dev/null 2>&1 || true
                ;;
        esac
    }

    # gtk/macos/win: there is no backend-neutral way to inject real GUI
    # input (synthesizing it would mean new per-backend code in src/gtk,
    # src/macos or src/win, which the platform-neutrality rule forbids), so
    # these backends launch the real app for the operator and print each
    # setup step as a manual instruction instead of performing it.
    manual_guided_driver() {
        local backend="$1" verb="$2" arg="${3:-}"
        case "$verb" in
            launch)
                echo "Guided $backend mode: start the real app yourself and follow the prompts below." >&2
                ;;
            send)
                echo "  -> manually: $arg" >&2
                ;;
            kill)
                : ;;
        esac
    }

    # launch/send/kill the real app for one checklist step. Delegates
    # entirely to REGRESS_GUIDED_CMD_<BACKEND> when set, mirroring
    # REGRESS_CMD_<BACKEND>, so tests never need real tmux or a real app.
    guided_driver() {
        local backend="$1" verb="$2" arg="${3:-}"
        local override_var="REGRESS_GUIDED_CMD_$(backend_upper "$backend")"
        local override="${!override_var:-}"
        if [[ -n "$override" ]]; then
            bash -c "$override" regress-guided-stub "$verb" "$arg"
            return $?
        fi
        case "$backend" in
            tui) tui_guided_driver "$verb" "$arg" ;;
            *) manual_guided_driver "$backend" "$verb" "$arg" ;;
        esac
    }

    items_tsv="$(checklist_items_tsv)"

    # GUIDED_N is counted as the rows are collected rather than read back as
    # ${#G_IDS[@]}: under `set -u`, bash 3.2 (macOS /bin/bash) treats an empty
    # array as unset, so the zero-item case would abort instead of reaching
    # the error message below.
    declare -a G_IDS=() G_PROMPTS=() G_REFS=() G_SETUPS=()
    GUIDED_N=0
    while IFS=$'\x1f' read -r i_id i_prompt i_ref i_backends i_setup; do
        [[ -z "$i_id" ]] && continue
        if item_applies_to_backend "$i_backends" "$BACKEND"; then
            G_IDS+=("$i_id")
            G_PROMPTS+=("$i_prompt")
            G_REFS+=("$i_ref")
            G_SETUPS+=("$i_setup")
            GUIDED_N=$((GUIDED_N + 1))
        fi
    done <<< "$items_tsv"

    if [[ "$GUIDED_N" -eq 0 ]]; then
        echo "error: no checklist items apply to backend '$BACKEND'" >&2
        exit $EXIT_FAIL
    fi

    echo "=== regress --guided: backend=$BACKEND ($GUIDED_N item(s)) ==="
    echo "Checklist: $CHECKLIST_FILE"
    echo ""

    guided_driver "$BACKEND" launch

    GUIDED_CLEANED_UP=false
    guided_cleanup() {
        if ! $GUIDED_CLEANED_UP; then
            GUIDED_CLEANED_UP=true
            guided_driver "$BACKEND" kill
        fi
    }
    trap guided_cleanup EXIT

    declare -a R_STATUS=() R_NOTES=()
    GUIDED_PASS=0
    GUIDED_FAIL=0
    GUIDED_SKIP=0

    for ((g_idx = 0; g_idx < GUIDED_N; g_idx++)); do
        item_id="${G_IDS[$g_idx]}"
        item_prompt="${G_PROMPTS[$g_idx]}"
        item_ref="${G_REFS[$g_idx]}"
        item_setup="${G_SETUPS[$g_idx]}"

        if [[ -n "$item_setup" ]]; then
            declare -a g_steps=()
            IFS=',' read -ra g_steps <<< "$item_setup"
            for g_step in "${g_steps[@]}"; do
                guided_driver "$BACKEND" send "$g_step"
            done
        fi

        echo ""
        echo "[$((g_idx + 1))/$GUIDED_N] $item_id"
        echo "  $item_prompt"
        if [[ -n "$item_ref" ]]; then
            echo "  Reference: $item_ref"
        fi
        printf "  Pass (y) / Fail (n) / Skip (s)? "

        g_status="skip"
        g_note=""
        while true; do
            g_answer=""
            if ! IFS= read -r g_answer; then
                g_answer="s"
            fi
            g_char="$(printf '%s' "$g_answer" | cut -c1 | tr '[:upper:]' '[:lower:]')"
            case "$g_char" in
                y)
                    g_status="pass"
                    break
                    ;;
                s)
                    g_status="skip"
                    break
                    ;;
                n)
                    g_status="fail"
                    g_note="$(printf '%s' "${g_answer:1}" | sed -E 's/^[[:space:]]+//')"
                    break
                    ;;
                *)
                    printf "  please answer y, n, or s: "
                    ;;
            esac
        done

        R_STATUS+=("$g_status")
        R_NOTES+=("$g_note")
        case "$g_status" in
            pass) GUIDED_PASS=$((GUIDED_PASS + 1)) ;;
            fail) GUIDED_FAIL=$((GUIDED_FAIL + 1)) ;;
            skip) GUIDED_SKIP=$((GUIDED_SKIP + 1)) ;;
        esac
    done

    guided_cleanup
    trap - EXIT

    GUIDED_SHA="$(cd "$REPO_DIR" && git rev-parse --short HEAD 2>/dev/null || echo "nogit")"
    GUIDED_DATE="$(date +%Y-%m-%d)"
    GUIDED_OUT_DIR="${REGRESS_GUIDED_OUT_DIR:-$REPO_DIR}"
    mkdir -p "$GUIDED_OUT_DIR"
    GUIDED_OUT_FILE="$GUIDED_OUT_DIR/regress-$BACKEND-$GUIDED_SHA-$GUIDED_DATE.md"

    {
        echo "# Guided regression checklist"
        echo ""
        echo "- Backend: $BACKEND"
        echo "- Commit: $GUIDED_SHA"
        echo "- Date: $GUIDED_DATE"
        echo ""
        for ((g_idx = 0; g_idx < GUIDED_N; g_idx++)); do
            g_mark="[ ]"
            [[ "${R_STATUS[$g_idx]}" == "pass" ]] && g_mark="[x]"
            case "${R_STATUS[$g_idx]}" in
                pass) g_label="PASS" ;;
                fail) g_label="FAIL" ;;
                skip) g_label="SKIP" ;;
            esac
            if [[ "${R_STATUS[$g_idx]}" == "fail" && -n "${R_NOTES[$g_idx]}" ]]; then
                g_label="$g_label: ${R_NOTES[$g_idx]}"
            fi
            echo "- $g_mark ${G_IDS[$g_idx]} -- $g_label"
            echo "      ${G_PROMPTS[$g_idx]}"
        done
    } > "$GUIDED_OUT_FILE"

    echo ""
    echo "=== regress --guided summary ==="
    echo "Backend:  $BACKEND"
    echo "Total:    $GUIDED_N"
    echo "Pass:     $GUIDED_PASS"
    echo "Fail:     $GUIDED_FAIL"
    echo "Skip:     $GUIDED_SKIP"
    echo "Results:  $GUIDED_OUT_FILE"

    GUIDED_VERDICT="pass"
    [[ "$GUIDED_FAIL" -gt 0 ]] && GUIDED_VERDICT="fail"
    echo "GUIDED_SUMMARY backend=$BACKEND total=$GUIDED_N pass=$GUIDED_PASS fail=$GUIDED_FAIL skip=$GUIDED_SKIP verdict=$GUIDED_VERDICT file=$GUIDED_OUT_FILE"

    if [[ "$GUIDED_FAIL" -gt 0 ]]; then
        exit $EXIT_FAIL
    fi
    exit $EXIT_PASS
fi

# -- Build the cargo test command -------------------------------------------

cd "$REPO_DIR"

cargo_cmd=()
cargo_test_filter=""

case "$BACKEND" in
    tui)
        cargo_cmd=(cargo test --no-default-features)
        cargo_test_filter="harness::"
        ;;
    gtk)
        cargo_cmd=(cargo test)
        cargo_test_filter="harness::"
        ;;
    macos)
        cargo_cmd=(cargo test --lib --no-default-features --features macos)
        cargo_test_filter="macos::"
        ;;
    win)
        if [[ "$(uname -s)" == *MINGW* ]] || [[ "$(uname -s)" == *MSYS* ]] || [[ "$(uname -s)" == *CYGWIN* ]]; then
            cargo_cmd=(cargo test --no-default-features --features win)
        else
            export RUSTFLAGS="${RUSTFLAGS:-} -C target-feature=+crt-static"
            cargo_cmd=(cargo xwin test --target x86_64-pc-windows-msvc --no-default-features --features win)
        fi
        cargo_test_filter="win::"
        ;;
esac

CMD_OVERRIDE_VAR="REGRESS_CMD_$(backend_upper "$BACKEND")"
CMD_OVERRIDE="${!CMD_OVERRIDE_VAR:-}"
if [[ -n "$CMD_OVERRIDE" ]]; then
    cargo_cmd=(bash -c "$CMD_OVERRIDE" regress-stub)
fi

# -- Area filter -> cargo test name filter ----------------------------------

if [[ -n "$AREA" ]]; then
    case "$AREA" in
        tab-bar)         cargo_test_filter="harness::.*tab_bar" ;;
        scroll)          cargo_test_filter="harness::.*scroll" ;;
        source-control)  cargo_test_filter="harness::.*sc_" ;;
        activity-bar)    cargo_test_filter="harness::.*activity_bar" ;;
        context-menu)    cargo_test_filter="harness::.*context_menu" ;;
        command-palette) cargo_test_filter="harness::.*command_palette" ;;
        drag-drop)       cargo_test_filter="harness::.*drag" ;;
        settings)        cargo_test_filter="harness::.*settings" ;;
        keyboard)        cargo_test_filter="harness::.*ctrl_w" ;;
        explorer|file-ops) cargo_test_filter="harness::.*explorer" ;;
        editor)          cargo_test_filter="harness::.*hover" ;;
        chrome)          cargo_test_filter="harness::.*confirm\|harness::.*sweep\|harness::.*bottom" ;;
        debug-output)    cargo_test_filter="harness::.*debug_output" ;;
        *)
            echo "warning: unknown area '$AREA', running all scenarios" >&2
            ;;
    esac
fi

# -- Run --------------------------------------------------------------------

echo "=== regress: backend=$BACKEND area=${AREA:-all} ==="
echo "Command: ${cargo_cmd[*]} -- $cargo_test_filter"
echo ""

# The full cargo output is kept on disk (never deleted) and its path is
# always printed, so the operator can inspect the complete log after the
# short table below.
OUTFILE="$(mktemp -t "vimcode-regress.${BACKEND}.XXXXXX.log")"

set +e
"${cargo_cmd[@]}" -- "$cargo_test_filter" 2>&1 | tee "$OUTFILE"
TEST_EXIT=${PIPESTATUS[0]}
set -e

# -- Parse results ----------------------------------------------------------
#
# `cargo test` runs one "test result:" line *per test binary* (the lib
# unittests, each integration-test file, each bin target), not one for the
# whole invocation. Only the binary that actually contains harness::/macos::/
# win:: tests reports a nonzero count; the rest report "0 passed; 0 failed"
# for that binary. Summing across every "test result:" line (rather than
# reading just the last one) gives the true total regardless of how many
# binaries cargo happened to run.

PASSED=$(grep -E '^test result: ' "$OUTFILE" | grep -oE '[0-9]+ passed' | grep -oE '[0-9]+' | awk '{s+=$1} END{print s+0}')
FAILED=$(grep -E '^test result: ' "$OUTFILE" | grep -oE '[0-9]+ failed' | grep -oE '[0-9]+' | awk '{s+=$1} END{print s+0}')

# The #645 vacuous-green guard: if zero tests ran, that is a failure.
TOTAL=$((PASSED + FAILED))
if [[ $TOTAL -eq 0 && $TEST_EXIT -eq 0 ]]; then
    echo ""
    echo "ERROR: zero tests ran -- this is the #645 vacuous-green trap, not a pass."
    echo "The backend '$BACKEND' with filter '$cargo_test_filter' matched no test functions."
    TEST_EXIT=1
fi

# -- Per-scenario table -------------------------------------------------
# Build one row per scenario per backend variant actually reported by
# cargo's own test harness, so this table can never disagree with
# `cargo test`'s own verdict for the scenario it describes. For tui/gtk,
# scenario names are cross-referenced against the full label set from
# src/harness.rs so a scenario that didn't run at all (e.g. filtered out
# by --area) is still shown, as a skip, rather than silently omitted.

declare -a TABLE_ROWS=()

parse_backend_suffix() {
    case "$1" in
        *::tui_prod) echo "tui_prod" ;;
        *::tui)      echo "tui" ;;
        *::gtk)      echo "gtk" ;;
        *)           echo "" ;;
    esac
}

# Lines look like: "test harness::tests::some_label::tui ... ok". Some
# driver tests write a raw terminal title-set escape sequence straight to
# the fd with no trailing newline, which can land immediately before the
# next test's result line and shift it off column 0 -- so the match below
# is not anchored to the start of the line, only to "test <path> ... ".
while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    test_path=$(echo "$line" | sed -E 's/.*test ([^ ]+) \.\.\..*/\1/')
    outcome=$(echo "$line" | sed -E 's/.*test [^ ]+ \.\.\. (ok|FAILED|ignored).*/\1/')
    suffix=$(parse_backend_suffix "$test_path")
    if [[ -n "$suffix" ]]; then
        # harness::...::<label>::<suffix> -> <label> is the segment before the suffix.
        label=$(echo "$test_path" | sed -E "s/::${suffix}\$//" | sed -E 's/.*:://')
    else
        label="$test_path"
        suffix="$BACKEND"
    fi
    case "$outcome" in
        ok)      result="pass" ;;
        FAILED)  result="fail" ;;
        ignored) result="skip (cargo test marked #[ignore])" ;;
        *)       result="unknown" ;;
    esac
    TABLE_ROWS+=("${label}\t${suffix}\t${result}")
done < <(grep -E 'test [^ ]+ \.\.\. (ok|FAILED|ignored)' "$OUTFILE" || true)

# For tui/gtk, add a skip row for every registered scenario that produced
# no row at all (most commonly: filtered out by --area).
#
# The lookup below is a newline-delimited string tested with bash's own
# pattern match, for two independent reasons:
#
#   * Not a `printf ... | grep -q` pipeline. Under `set -o pipefail` (part
#     of `set -euo pipefail` above), a `grep -q` that matches and exits
#     early can SIGPIPE the still-writing `printf`, and pipefail then
#     reports that SIGPIPE as the pipeline's exit status even though the
#     grep match itself succeeded -- turning a real match into a spurious
#     "not matched" skip row for a scenario that actually ran and passed.
#     That failure mode is data-dependent (it only shows up when a match
#     lands early enough in a large TABLE_ROWS to let the writer get
#     SIGPIPE'd), so it does not reproduce on every run with every label.
#   * Not an associative array (`declare -A`). That needs bash 4, and
#     macOS ships bash 3.2 as /bin/bash, where `declare -A` aborts the
#     whole script under `set -e`.
#
# Every entry is stored surrounded by newlines so a `*\n<label>\n*` match
# is always whole-label and never a substring of a longer label.
if [[ "$BACKEND" == "tui" || "$BACKEND" == "gtk" ]]; then
    SEEN_LABELS=$'\n'
    for row in "${TABLE_ROWS[@]:-}"; do
        [[ -z "$row" ]] && continue
        row_label="${row%%\\t*}"
        SEEN_LABELS+="${row_label}"$'\n'
    done

    ALL_LABELS=$(all_labels)
    while IFS= read -r label; do
        [[ -z "$label" ]] && continue
        if [[ "$SEEN_LABELS" != *$'\n'"$label"$'\n'* ]]; then
            reason="not matched by filter '$cargo_test_filter'"
            TABLE_ROWS+=("${label}\t${BACKEND}\tskip (${reason})")
        fi
    done <<< "$ALL_LABELS"
fi

# -- Output -----------------------------------------------------------------

VERDICT="$([ $TEST_EXIT -eq 0 ] && echo "pass" || echo "fail")"

# Normalise to the documented exit contract. `cargo test` signals a test
# failure with 101, and a caller gating on this script must be able to tell
# "scenarios failed" (1) from "backend unavailable" (2) and "bad invocation"
# (3) by exit code alone, so any nonzero cargo status collapses to EXIT_FAIL.
EXIT_CODE=$EXIT_PASS
if [[ $TEST_EXIT -ne 0 ]]; then
    EXIT_CODE=$EXIT_FAIL
fi

echo ""
echo "=== regress: per-scenario results ==="
printf "%-70s %-10s %s\n" "SCENARIO" "BACKEND" "RESULT"
printf "%-70s %-10s %s\n" "--------" "-------" "------"
for row in "${TABLE_ROWS[@]:-}"; do
    [[ -z "$row" ]] && continue
    IFS=$'\t' read -r r_label r_backend r_result <<< "$(echo -e "$row")"
    printf "%-70s %-10s %s\n" "$r_label" "$r_backend" "$r_result"
done

echo ""
echo "Full log: $OUTFILE"
echo ""
echo "=== regress summary ==="

if $JSON; then
    cat <<ENDJSON
{
  "backend": "$BACKEND",
  "area": "${AREA:-all}",
  "passed": $PASSED,
  "failed": $FAILED,
  "total": $TOTAL,
  "verdict": "$VERDICT",
  "exit": $EXIT_CODE,
  "log": "$OUTFILE"
}
ENDJSON
else
    echo "Backend:  $BACKEND"
    echo "Area:     ${AREA:-all}"
    echo "Passed:   $PASSED"
    echo "Failed:   $FAILED"
    echo "Total:    $TOTAL"
    echo "Log:      $OUTFILE"
    if [[ $EXIT_CODE -eq 0 ]]; then
        echo "Verdict:  PASS"
    else
        echo "Verdict:  FAIL"
    fi
fi

echo "REGRESS_SUMMARY backend=$BACKEND area=${AREA:-all} passed=$PASSED failed=$FAILED total=$TOTAL verdict=$VERDICT exit=$EXIT_CODE log=$OUTFILE"

exit $EXIT_CODE
